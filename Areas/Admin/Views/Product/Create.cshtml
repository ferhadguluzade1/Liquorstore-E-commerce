﻿@using Liquorstore_E_commerce.Areas.Admin.ViewModels.Product
@model CreateProductViewModel

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Add Book</h1>
    <p class="mb-4">Fill the form below to add a new book to the catalog.</p>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Add Book</h6>
            <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
        </div>
        <div class="card-body">
            <form asp-action="Create" asp-area="Admin" asp-controller="Book" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="ProductName">Product Name</label>
                        <input asp-for="ProductName" class="form-control" placeholder="This is a name of current product" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                        <small class="form-text text-muted">Accepted: .jpg, .png. (You may also upload files below.)</small>
                    </div>

                    <div class="form-group col-md-8">
                        <label asp-for="Price">Price</label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
               
                    <div class="form-group col-md-3">
                        <label asp-for="Price">Price</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="DiscountPrice">Discount Rate (%)</label>
                        <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="DiscountPrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="Brand">Brand</label>
                        <input asp-for="Brand" class="form-control" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="BrandId">Publisher</label>
                        <input asp-for="BrandId" class="form-control" />
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>

                   
                </div>

                <div class="form-row">
                    

                    <div class="form-group col-md-9">
                        <label asp-for="Categories">Categories</label>
                        <select asp-for="Categories" asp-items="ViewBag.Categories" class="form-control" multiple="multiple"></select>
                        <span asp-validation-for="Categories" class="text-danger"></span>
                        <small class="form-text text-muted">Hold Ctrl (Cmd on Mac) to select multiple categories.</small>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ProductImageUrl">Upload Images</label>
                    <input asp-for="ProductImageUrl" class="form-control-file" type="file" multiple />
                    <span asp-validation-for="ProductImageUrl" class="text-danger"></span>
                    <small class="form-text text-muted">You can upload multiple images. Server will save files and populate ImageUrl accordingly.</small>
                </div>
            </form>
        </div>
    </div>

</div>
<!-- /.container-fluid -->
<!-- End of Main Content -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}